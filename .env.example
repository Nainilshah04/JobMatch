# ==========================================
# JobMatch Backend Environment Configuration
# ==========================================

# PostgreSQL connection string with pgvector extension (Neon recommended)
# e.g., postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobmatch

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Configuration (Phase 4 explanation & rerank)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Server Configuration
HOST=0.0.0.0
PORT=8000
